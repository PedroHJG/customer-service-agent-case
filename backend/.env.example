ANTHROPIC_API_KEY=sk-ant-...

# Modelo e profundidade de raciocínio (low | medium | high | xhigh | max)
CLAUDE_MODEL=claude-opus-5-5
CLAUDE_EFFORT=medium

# Momento simulado do relógio da loja, para testar prazos de troca e horário de atendimento.
# "2026-03-25T19:30" (data e hora) ou "2026-03-25" (só data, hora real). O relógio anda a partir dele.
# Vazio = relógio real
REFERENCE_DATETIME=2026-03-25T10:00

# Modelo barato para classificar escopo (circuit breaker) e resumir o histórico
AUXILIARY_MODEL=claude-haiku-5-5
# Mensagens seguidas fora do escopo até o agente pausar e responder com texto padrão
OUT_OF_SCOPE_THRESHOLD=5
# Turnos do cliente até o histórico ser resumido (só os turnos dentro do escopo entram no resumo)
SUMMARY_AFTER_TURNS=12

DATABASE_URL=postgresql://emporio:emporio@localhost:5433/emporio
FRONTEND_ORIGIN=http://localhost:3000
